---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" descripcion="Esta página no existe en la edición actual.">
  <section class="portada ancho">
    <p class="mono">Error 404</p>
    <h1>Esta página<br />no existe</h1>
    <p class="correccion">
      <span class="oculto">Antes había aquí:</span>
      <s>Una página que ya no está</s>
    </p>
    <p class="frase">Puede que la haya corregido o movido en esta edición.</p>
    <p class="accesos">
      <a href="/">Volver a la portada →</a>
      <a href="/#casos">Ver casos</a>
    </p>
  </section>
</Base>
