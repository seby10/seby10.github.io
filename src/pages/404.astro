---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import es from '../i18n/es';
import en from '../i18n/en';
---

<Base lang="es" titulo={es.error.titulo} descripcion={es.error.texto}>
  <section class="perdido portada" aria-labelledby="perdido-titulo">
    <div class="cielo-css" aria-hidden="true"></div>
    <div class="contenido ancho">
      <svg class="astronauta" viewBox="0 0 120 140" aria-hidden="true">
        <g fill="none" stroke="#eef1f8" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <path d="M38 70 Q20 78 22 96" />
          <path d="M82 70 Q100 62 104 46" />
          <rect x="34" y="58" width="52" height="50" rx="18" fill="#151a31" />
          <path d="M46 108 v18 M74 108 v18" />
          <circle cx="60" cy="40" r="26" fill="#151a31" />
          <path d="M44 38 a16 14 0 0 1 32 0 v4 a16 12 0 0 1 -32 0z" fill="#6ec8f5" stroke="#6ec8f5" />
          <rect x="48" y="72" width="24" height="14" rx="3" />
        </g>
        <circle cx="66" cy="37" r="3" fill="#eef1f8" />
        <circle cx="54" cy="79" r="2.4" fill="#c9f562" />
      </svg>
      <p class="mono" style="color: var(--lima)">404</p>
      <h1 id="perdido-titulo">{es.error.titulo}</h1>
      <p>{es.error.texto}</p>
      <p lang="en">{en.error.texto}</p>
      <p class="acciones" style="display:flex;gap:.75rem;flex-wrap:wrap;justify-content:center">
        <a class="boton principal" href="/">{es.error.volver} <Icono nombre="derecha" /></a>
        <a class="boton" href="/en/" lang="en">{en.error.volver}</a>
      </p>
    </div>
  </section>

  <script>
    const astro = document.querySelector<SVGElement>('.astronauta');
    if (astro && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      let x = 0, y = 0, tx = 0, ty = 0;
      addEventListener('pointermove', (e) => {
        tx = (e.clientX / innerWidth - 0.5) * 60;
        ty = (e.clientY / innerHeight - 0.5) * 40;
      }, { passive: true });
      const paso = (t: number) => {
        x += (tx - x) * 0.03;
        y += (ty - y) * 0.03;
        astro.style.transform = `translate(${x}px, ${y + Math.sin(t / 900) * 8}px) rotate(${Math.sin(t / 1400) * 8 + x * 0.1}deg)`;
        requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    }
  </script>
</Base>
