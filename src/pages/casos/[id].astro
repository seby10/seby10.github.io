---
import { getCollection } from 'astro:content';
import Caso from '../../components/Caso.astro';

export async function getStaticPaths() {
  return (await getCollection('casos', (c) => c.id.startsWith('es/') && c.data.seccion === 'caso')).map((c) => ({
    params: { id: c.id.split('/')[1] },
  }));
}
---

<Caso lang="es" id={Astro.params.id} />
