---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Nota from '../../components/Nota.astro';
import { ESTADOS } from '../../data/edicion';

export async function getStaticPaths() {
  const casos = await getCollection('casos', (c) => c.data.seccion === 'caso');
  return casos.map((caso) => ({ params: { id: caso.id }, props: { caso } }));
}

const { caso } = Astro.props;
const c = caso.data;
const { Content: Problema } = await render(caso);
const enRedaccion = !caso.body?.trim();
const [principal, ...otras] = c.figuras;
const tamanos = '(min-width: 62rem) 44rem, 100vw';
---

<Base titulo={c.titulo} descripcion={c.resumen}>
  <div class="ancho pagina-caso">
    <p class="mono"><a href="/#casos">← 03 · Casos</a></p>

    <article class="caso">
      <header class="caso-cab">
        <h1>{c.titulo}</h1>
        <span class="mono estado">{ESTADOS[c.estado]} · {c.anio}</span>
      </header>

      {
        principal && (
          <figure class="figura">
            <Image src={principal.src} alt={principal.alt} widths={[640, 1280]} sizes={tamanos} loading="eager" />
            {principal.pie && <figcaption class="mono">{principal.pie}</figcaption>}
          </figure>
        )
      }

      <div class="problema">
        {enRedaccion ? <p>{c.resumen}</p> : <Problema />}
        {enRedaccion && <p class="pendiente">Caso en redacción.</p>}
      </div>

      {
        !enRedaccion && (
          <dl class="campos">
            <div>
              <dt>Mi parte</dt>
              <dd>
                {c.equipo && <p>{c.equipo}</p>}
                <ul>
                  {c.parte.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </dd>
            </div>
            <div>
              <dt>Decisiones</dt>
              <dd>
                <ul>
                  {c.decisiones.map((d) => (
                    <li>
                      <strong>{d.titulo}.</strong> {d.texto}
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
            <div>
              <dt>Estado</dt>
              <dd>{c.estadoDetalle}</dd>
            </div>
            {(c.porMejorar || import.meta.env.DEV) && (
              <div>
                <dt>Por mejorar</dt>
                <dd class:list={{ pendiente: !c.porMejorar }}>{c.porMejorar ?? 'Tu línea va aquí.'}</dd>
              </div>
            )}
            <div>
              <dt>Enlaces</dt>
              <dd class="enlaces">
                {c.enlaces.map((e) => (
                  <a href={e.url}>{e.texto}</a>
                ))}
              </dd>
            </div>
          </dl>
        )
      }

      {
        otras.map((f) => (
          <figure class="figura">
            <Image src={f.src} alt={f.alt} widths={[640, 1280]} sizes={tamanos} />
            {f.pie && <figcaption class="mono">{f.pie}</figcaption>}
          </figure>
        ))
      }

      {c.nota && <Nota texto={c.nota.texto} fecha={c.nota.fecha} de={c.titulo} />}
    </article>
  </div>
</Base>
