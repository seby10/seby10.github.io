---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { ESTADOS } from '../../data/perfil';

export async function getStaticPaths() {
  const casos = (await getCollection('casos', (c) => c.data.seccion === 'caso')).sort(
    (a, b) => a.data.orden - b.data.orden,
  );
  return casos.map((caso, i) => ({ params: { id: caso.id }, props: { caso, siguiente: casos[(i + 1) % casos.length] } }));
}

const { caso, siguiente } = Astro.props;
const c = caso.data;
const { Content: Problema } = await render(caso);
const [principal, ...otras] = c.figuras;
const tamanos = '(min-width: 72rem) 68rem, 100vw';
---

<Base titulo={c.titulo} descripcion={c.resumen}>
  <article class="ancho pagina-caso">
    <a class="volver mono" href="/#proyectos">← Todos los proyectos</a>

    <header class="caso-cab">
      <p class="tarjeta-meta mono">
        <span class="estado">{ESTADOS[c.estado]}</span>
        <span>{c.anio}</span>
      </p>
      <h1 data-descifrar>{c.titulo}</h1>
      <p class="resumen">{c.resumen}</p>
      <ul class="chips" aria-label="Stack">
        {c.stack.map((s) => <li class="chip">{s}</li>)}
      </ul>
      <div class="acciones">
        {c.enlaces.map((e, i) => <a class:list={['boton', { principal: i === 0 }]} href={e.url}>{e.texto}</a>)}
      </div>
    </header>

    {
      principal && (
        <figure class="figura">
          <Image src={principal.src} alt={principal.alt} widths={[640, 1280, 1600]} sizes={tamanos} loading="eager" />
          {principal.pie && <figcaption class="mono">{principal.pie}</figcaption>}
        </figure>
      )
    }

    <div class="caso-cuerpo">
      <section aria-labelledby="problema">
        <h2 id="problema">El problema</h2>
        <div class="prosa-caso" data-revelar>
          {caso.body?.trim() ? <Problema /> : <p>{c.resumen}</p>}
        </div>
      </section>
      <dl class="ficha" data-revelar>
        <div>
          <dt>Mi parte</dt>
          <dd>
            {c.equipo && <p style="margin-bottom: 0.6rem">{c.equipo}</p>}
            <ul>
              {c.parte.map((p) => <li>{p}</li>)}
            </ul>
          </dd>
        </div>
        {
          c.estadoDetalle && (
            <div>
              <dt>Estado</dt>
              <dd>{c.estadoDetalle}</dd>
            </div>
          )
        }
      </dl>
    </div>

    {
      c.decisiones.length > 0 && (
        <section class="caso-decisiones" aria-labelledby="decisiones">
          <h2 id="decisiones">Decisiones</h2>
          <ul class="decisiones">
            {c.decisiones.map((d) => (
              <li data-revelar>
                <h3>{d.titulo}</h3>
                <p>{d.texto}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      otras.map((f) => (
        <figure class="figura" data-revelar>
          <Image src={f.src} alt={f.alt} widths={[640, 1280, 1600]} sizes={tamanos} />
          {f.pie && <figcaption class="mono">{f.pie}</figcaption>}
        </figure>
      ))
    }

    <a class="siguiente" href={`/casos/${siguiente.id}/`}>
      <span>
        <span class="mono" style="color: var(--texto-2)">Siguiente proyecto</span>
        <strong>{siguiente.data.titulo}</strong>
      </span>
      <span class="flecha" aria-hidden="true">→</span>
    </a>
  </article>
</Base>
