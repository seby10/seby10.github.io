---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import retrato from '../assets/sebastian.jpg';
import Base from '../layouts/Base.astro';
import Aurora from '../components/Aurora.astro';
import Seccion from '../components/Seccion.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import Logo from '../components/Logo.astro';
import { contacto, experiencia, formacion, perfil, portada, secciones, sobreMi, stack } from '../data/perfil';

const todos = (await getCollection('casos')).sort((a, b) => a.data.orden - b.data.orden);
const casos = todos.filter((c) => c.data.seccion === 'caso');
const archivo = todos.filter((c) => c.data.seccion === 'archivo');
const num = Object.fromEntries(secciones.map((s, i) => [s.id, { ...s, num: i + 1 }]));
---

<Base>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: perfil.nombre,
      jobTitle: perfil.rol,
      url: 'https://seby10.github.io/',
      image: 'https://seby10.github.io/og.png',
      email: `mailto:${perfil.correo}`,
      homeLocation: { '@type': 'Place', name: perfil.lugar },
      alumniOf: { '@type': 'CollegeOrUniversity', name: formacion.universidad },
      knowsAbout: [...portada.stack, 'TypeScript', 'Inteligencia artificial'],
      knowsLanguage: ['es', 'en', 'fr'],
      sameAs: [perfil.github],
    })}
  />

  <section class="portada" aria-labelledby="nombre">
    <Aurora />
    <div class="ancho portada-texto">
      <p class="rol mono">{perfil.rol}</p>
      <h1 id="nombre" data-descifrar>{perfil.nombre}</h1>
      <p class="construyo">
        Construyo <span class="rota" data-rotar={JSON.stringify(portada.construyo)}>{portada.construyo[0]}</span>.
      </p>
      <div class="portada-datos">
        <span class="estado disponible mono">{portada.disponible}</span>
        <span class="mono">{portada.modalidad}</span>
      </div>
      <ul class="chips" aria-label="Stack principal">
        {portada.stack.map((s) => <li class="chip">{s}</li>)}
      </ul>
      <div class="acciones">
        <a class="boton principal" href="#proyectos">Ver proyectos <span class="flecha">→</span></a>
        <a class="boton" href="#contacto">Escribirme</a>
      </div>
    </div>
    <p class="pista mono" aria-hidden="true">El cielo responde a los clics</p>
  </section>

  <Seccion {...num['sobre-mi']}>
    <div class="sobre">
      <div class="prosa" data-revelar>
        {sobreMi.map((p) => <p>{p}</p>)}
      </div>
      <Image class="retrato" src={retrato} alt={`Retrato de ${perfil.nombre}`} width={256} height={256} densities={[1, 2]} data-revelar />
    </div>
  </Seccion>

  <Seccion {...num['proyectos']}>
    <div class="tarjetas">
      {casos.map((caso, i) => <TarjetaProyecto caso={caso} destacada={i === 0} />)}
    </div>

    <div class="mas">
      <h3 data-revelar>Más proyectos</h3>
      <ul class="mini">
        {
          archivo.map((p) => {
            const enlace = p.data.enlaces[0];
            return (
              <li data-revelar>
                <h4>{p.data.titulo}</h4>
                <p>{p.data.resumen}</p>
                <div class="pie-mini">
                  <span class="mono">{p.data.stack.join(' · ')}</span>
                  {enlace && (
                    <a href={enlace.url} aria-label={`${enlace.texto} de ${p.data.titulo}`}>
                      {enlace.texto}
                    </a>
                  )}
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </Seccion>

  <Seccion {...num['experiencia']}>
    <ol class="linea-tiempo">
      {
        experiencia.map((e) => (
          <li class="puesto" data-revelar>
            <span class="fecha mono">{e.fecha}</span>
            <h3>
              {e.cargo} <span>· {e.lugar}</span>
            </h3>
            <ul class="logros">
              {e.logros.map((l) => (
                <li>{l}</li>
              ))}
            </ul>
            {e.stack.length > 0 && (
              <ul class="chips" aria-label="Stack">
                {e.stack.map((s) => (
                  <li class="chip">{s}</li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ol>
  </Seccion>

  <Seccion {...num['stack']}>
    <div class="grupos">
      {
        stack.map((g) => (
          <div class="grupo" data-revelar>
            <h3>{g.grupo}</h3>
            <ul class="chips">
              {g.lista.map((s) => (
                <li class="chip">{s}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Seccion>

  <Seccion {...num['formacion']}>
    <div class="formacion">
      <div class="bloque" data-revelar>
        <span class="mono sub">{formacion.fecha}</span>
        <h3>{formacion.carrera}</h3>
        <p class="sub">{formacion.universidad}</p>
        <p>{formacion.detalle}</p>
        <p class="idiomas">
          {
            formacion.idiomas.map((i) => (
              <span>
                <strong>{i.idioma}</strong> {i.nivel}
              </span>
            ))
          }
        </p>
      </div>
      <div class="bloque" data-revelar>
        <h3>Logros y certificados</h3>
        <ul class="lista-logros">
          {
            formacion.logros.map((l) => (
              <li>
                <span class="mono">{l.fecha}</span>
                <div>
                  {l.url ? <a href={l.url}>{l.titulo}</a> : <strong>{l.titulo}</strong>}
                  <br />
                  <span>{l.texto}</span>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Seccion>

  <section id="contacto" class="seccion contacto ancho" aria-labelledby="contacto-titulo">
    <div class="contacto-caja" data-revelar>
      <Logo />
      <span class="mono" style="color: var(--verde)" aria-hidden="true">{String(num['contacto'].num).padStart(2, '0')}</span>
      <h2 id="contacto-titulo">¿Hablamos?</h2>
      <p class="frase">{contacto.frase}</p>
      <a class="correo" href={`mailto:${perfil.correo}`}>{perfil.correo}</a>
      <div class="acciones">
        <a class="boton principal" href={`mailto:${perfil.correo}`}>Escribirme <span class="flecha">→</span></a>
        <a class="boton" href={perfil.github}>GitHub</a>
      </div>
      <p class="personal">{contacto.personal}</p>
    </div>
    <footer class="pie mono">
      <span>© 2026 {perfil.nombre} · {perfil.lugar}</span>
      <a href={perfil.repo}>Hecho con Astro, GSAP y un shader propio</a>
    </footer>
  </section>
</Base>
