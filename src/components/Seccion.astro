---
interface Props {
  id: string;
  num: number;
  titulo: string;
  class?: string;
}

const { id, num, titulo, class: clase } = Astro.props;
---

<section id={id} class:list={['seccion ancho', clase]} aria-labelledby={`${id}-titulo`}>
  <div class="seccion-cab" data-revelar>
    <span class="mono" aria-hidden="true">{String(num).padStart(2, '0')}</span>
    <h2 id={`${id}-titulo`}>{titulo}</h2>
  </div>
  <slot />
</section>
