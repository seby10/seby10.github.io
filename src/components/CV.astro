---
// Currículum en una página A4, claro y sobrio, pensado para imprimirse o guardarse como PDF.
// Los PDF de public/cv/ se generan desde aquí con `npm run cv`.
import '@fontsource-variable/geist';
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { datos, textos, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = textos(lang);
const casos = (await getCollection('casos', (c) => c.id.startsWith(`${lang}/`) && c.data.seccion === 'caso')).sort(
  (a, b) => a.data.orden - b.data.orden,
);
const sinProto = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/%C3%A1/g, 'á');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{`${datos.nombre} · ${t.cv.titulo}`}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="hoja">
      <header>
        <div>
          <h1>{datos.nombre}</h1>
          <p class="rol">{t.portada.rol} · NestJS · Next.js · PostgreSQL</p>
        </div>
        <Logo />
      </header>
      <p class="contacto">
        <span>{t.portada.lugar}</span>
        <a href={`mailto:${datos.correo}`}>{datos.correo}</a>
        <a href={datos.linkedin}>{sinProto(datos.linkedin)}</a>
        <a href={datos.github}>{sinProto(datos.github)}</a>
        <a href="https://seby10.github.io">seby10.github.io</a>
      </p>

      <section>
        <h2>{t.cv.secciones.perfil}</h2>
        <p>{t.cv.perfil}</p>
      </section>

      <section>
        <h2>{t.cv.secciones.stack}</h2>
        <p>{t.stack.grupos.slice(0, 2).flatMap((g) => g.lista).join(' · ')}</p>
      </section>

      <section>
        <h2>{t.cv.secciones.experiencia}</h2>
        {
          t.experiencia.lista.map((e) => (
            <article>
              <h3>
                {e.cargo} · {e.lugar} <span>{e.fecha}</span>
              </h3>
              <ul>
                {e.logros.map((l) => (
                  <li>{l}</li>
                ))}
              </ul>
              {e.stack.length > 0 && <p class="stack">{e.stack.join(' · ')}</p>}
            </article>
          ))
        }
      </section>

      <section>
        <h2>{t.cv.secciones.proyectos}</h2>
        {
          casos.map((c) => (
            <article>
              <h3>
                {c.data.titulo} <span>{c.data.anio}</span>
              </h3>
              <p>
                {c.data.resumen} {c.data.rol} <span class="stack">{c.data.stack.join(' · ')}</span>
              </p>
            </article>
          ))
        }
      </section>

      <div class="columnas">
        <section>
          <h2>{t.cv.secciones.formacion}</h2>
          <h3>
            {t.formacion.carrera} <span>{t.formacion.fecha}</span>
          </h3>
          <p>{t.formacion.universidad}. {t.formacion.detalle}</p>
        </section>
        <section>
          <h2>{t.cv.secciones.certificados}</h2>
          <ul class="sin">
            {
              t.formacion.logros.map((l) => (
                <li>
                  <strong>{l.titulo}</strong> · {l.texto.replace(/\.$/, '').replace(' Networking Academy', '')} · {l.fecha}
                </li>
              ))
            }
          </ul>
        </section>
        <section>
          <h2>{t.cv.secciones.idiomas}</h2>
          <ul class="sin">
            {t.formacion.idiomas.map((i) => <li><strong>{i.idioma}</strong> · {i.nivel}</li>)}
          </ul>
        </section>
      </div>
    </main>
    <style is:global>
      @page {
        size: A4;
        margin: 0;
      }
      * {
        box-sizing: border-box;
      }
      html {
        background: #e9ecf3;
      }
      @media print {
        html {
          background: #fff;
        }
        .hoja {
          min-height: 0;
        }
      }
      body {
        margin: 0;
        font: 400 8.6pt/1.35 'Geist Variable', system-ui, sans-serif;
        color: #121626;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
      }
      .hoja {
        width: 210mm;
        min-height: 297mm;
        margin: 0 auto;
        padding: 9mm 13mm 6mm;
        background: #fff;
      }
      header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        border-bottom: 2px solid #121626;
        padding-bottom: 3mm;
      }
      h1 {
        margin: 0;
        font-size: 21pt;
        font-weight: 650;
        letter-spacing: -0.04em;
        line-height: 1;
      }
      .rol {
        margin: 2mm 0 0;
        font-size: 11pt;
        color: #2f6f97;
        font-weight: 500;
      }
      .logo {
        width: 17mm;
        color: #121626;
      }
      .logo-trazo {
        fill: none;
        stroke: currentColor;
        stroke-width: 5.5;
        stroke-linecap: round;
      }
      .logo-satelite {
        fill: #6ec8f5;
      }
      .contacto {
        display: flex;
        flex-wrap: wrap;
        gap: 1mm 5mm;
        margin: 2.5mm 0 0;
        font-size: 8.6pt;
        color: #4a5168;
      }
      a {
        color: inherit;
        text-decoration: none;
      }
      section {
        margin-top: 2.8mm;
      }
      h2 {
        margin: 0 0 2mm;
        font-size: 8.4pt;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #2f6f97;
        font-weight: 600;
      }
      h2.segundo {
        margin-top: 4mm;
      }
      h3 {
        margin: 0 0 1mm;
        font-size: 10pt;
        font-weight: 600;
        display: flex;
        justify-content: space-between;
        gap: 4mm;
      }
      h3 span {
        font-weight: 400;
        color: #4a5168;
        white-space: nowrap;
      }
      p {
        margin: 0;
      }
      article {
        margin-bottom: 1.6mm;
      }
      ul {
        margin: 0;
        padding-left: 4mm;
      }
      ul.sin {
        padding: 0;
        list-style: none;
        display: grid;
        gap: 1mm;
      }
      .stack {
        font-size: 8.4pt;
        color: #4a5168;
        margin-top: 0.6mm;
      }
      .columnas {
        display: grid;
        grid-template-columns: 1.15fr 1.35fr 0.6fr;
        gap: 6mm;
        font-size: 8.4pt;
      }
      @media screen {
        .contacto a {
          display: inline-block;
          padding-block: 1.6mm;
        }
        .hoja {
          margin-block: 8mm;
          box-shadow: 0 10px 40px rgb(0 0 0 / 0.12);
        }
      }
      @media screen and (max-width: 220mm) {
        .hoja {
          width: 100%;
          margin: 0;
          padding: 6mm 5mm;
        }
        .columnas {
          grid-template-columns: 1fr;
          gap: 0;
        }
        .contacto a {
          padding-block: 1mm;
          overflow-wrap: anywhere;
        }
        header .logo {
          width: 12mm;
        }
      }
    </style>
  </body>
</html>
