---
// Monograma «SC»: una S de dos arcos y una C abierta como una órbita, con un satélite en lima.
// La misma geometría está en public/favicon.svg y en src/scripts/particulas.ts (figuraLogo).
interface Props {
  class?: string;
  titulo?: string;
}

const { class: clase, titulo } = Astro.props;
---

<svg
  class:list={['logo', clase]}
  viewBox="0 0 72 62"
  role={titulo ? 'img' : undefined}
  aria-label={titulo}
  aria-hidden={titulo ? undefined : 'true'}
>
  <path class="logo-trazo" d="M25.5 17.5A9 9 0 1 0 17 31A9 9 0 1 1 8.5 44.5" />
  <path class="logo-trazo" d="M60.7 18.3A18 18 0 1 0 60.7 43.7" />
  <circle class="logo-satelite" cx="64" cy="31" r="3.6" />
</svg>
