---
interface Props {
  texto: string;
  fecha?: string;
  /** Capítulo o caso al que pertenece: distingue cada nota para los lectores de pantalla. */
  de?: string;
}

// Sin fecha = borrador: se ve en local (`npm run dev`) y no sale en la versión publicada.
const { texto, fecha, de } = Astro.props;
const visible = Boolean(fecha) || import.meta.env.DEV;
---

{
  visible && (
    <aside class="nota" aria-label={de ? `Nota al margen: ${de}` : 'Nota al margen'}>
      <span class="mono">Nota · {fecha ?? 'Borrador'}</span>
      {texto}
    </aside>
  )
}
