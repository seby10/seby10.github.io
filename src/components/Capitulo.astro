---
// Un capítulo: cabecera numerada, una zona con margen (texto a la izquierda, nota a la derecha)
// y el resto del contenido a todo el ancho.
interface Props {
  num: string;
  id: string;
  titulo: string;
}

const { num, id, titulo } = Astro.props;
---

<section id={id} class="capitulo ancho" aria-labelledby={`${id}-titulo`}>
  <div class="capitulo-cab">
    <span class="mono" aria-hidden="true">{num}</span>
    <h2 id={`${id}-titulo`}>{titulo}</h2>
  </div>
  {
    (Astro.slots.has('intro') || Astro.slots.has('nota')) && (
      <div class="con-margen">
        <div class="prosa">
          <slot name="intro" />
        </div>
        <slot name="nota" />
      </div>
    )
  }
  <slot />
</section>
