---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/instrument-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import Loader from '../components/Loader.astro';
import { perfil } from '../data/perfil';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
}

const {
  titulo,
  descripcion = 'Desarrollador full stack en Ambato, Ecuador. Construyo aplicaciones web con NestJS, Next.js y PostgreSQL, y les sumo IA.',
  imagen = '/og.png',
} = Astro.props;
const tituloPagina = titulo ? `${titulo} · ${perfil.nombre}` : `${perfil.nombre} · ${perfil.rol}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenSocial = new URL(imagen, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="sitemap" href="/sitemap.xml" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#060e1c" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:site_name" content={perfil.nombre} />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${perfil.nombre}, ${perfil.rol}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>
  <body>
    <Loader />
    <a class="salto" href="#contenido">Saltar al contenido</a>

    <header class="barra">
      <div class="ancho">
        <a class="marca" href="/" aria-label={`${perfil.nombre}, inicio`}>
          <Logo />
          <span class="solo-ancho">{perfil.nombre}</span>
        </a>
        <nav aria-label="Principal">
          <a href="/#proyectos">Proyectos</a>
          <a class="solo-ancho" href="/#experiencia">Experiencia</a>
          <a class="boton principal" href="/#contacto">Escribirme</a>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <script>
      import '../scripts/movimiento';
      import '../scripts/huevos';
    </script>
  </body>
</html>
