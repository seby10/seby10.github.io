---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { capitulos, edicion } from '../data/edicion';

interface Props {
  titulo?: string;
  descripcion?: string;
  imagen?: string;
}

const {
  titulo,
  descripcion = 'Estudiante de Ingeniería en Software en Ambato. Construyo aplicaciones web y aplico IA en ellas.',
  imagen = '/og.png',
} = Astro.props;
const tituloPagina = titulo ? `${titulo} · Sebastián Constante` : `Sebastián Constante · Edición ${edicion.numero}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenSocial = new URL(imagen, Astro.site);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Se retira en la Fase 11, cuando los textos dejen de ser borradores. -->
    <meta name="robots" content="noindex" />
    <title>{tituloPagina}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    <link rel="sitemap" href="/sitemap.xml" />

    <link rel="icon" href="/favicon.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f3efe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141311" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_EC" />
    <meta property="og:site_name" content="Sebastián Constante" />
    <meta property="og:title" content={tituloPagina} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagenSocial} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sebastián Constante, Edición 01" />
    <meta name="twitter:card" content="summary_large_image" />

    <slot name="head" />
  </head>
  <body>
    <a class="salto" href="#contenido">Saltar al contenido</a>

    <header class="barra">
      <div class="ancho mono">
        <a href="/">Sebastián Constante</a>
        <span class="edicion">Edición {edicion.numero} · {edicion.fecha} · {edicion.lugar}</span>
        <nav aria-label="Principal">
          <button type="button" popovertarget="indice">Índice</button>
          <a href="/#colofon">Contacto</a>
        </nav>
      </div>
    </header>

    <nav id="indice" class="indice" popover aria-label="Índice de la edición">
      <div class="ancho">
        <button type="button" class="mono" popovertarget="indice" popovertargetaction="hide">Cerrar</button>
        <ol>
          {
            capitulos.map((c) => (
              <li>
                <a href={`/#${c.id}`}>
                  <span class="mono" aria-hidden="true">{c.num}</span>
                  {c.titulo}
                </a>
              </li>
            ))
          }
        </ol>
      </div>
    </nav>

    <main id="contenido">
      <slot />
    </main>

    <!-- El índice se cierra solo al elegir un capítulo. -->
    <script is:inline>
      document.getElementById('indice').addEventListener('click', (e) => {
        if (e.target.closest('a')) e.currentTarget.hidePopover?.();
      });
    </script>
  </body>
</html>
